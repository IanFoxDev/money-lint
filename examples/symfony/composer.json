{
    "name": "ianfoxdev/money-lint-example-symfony",
    "description": "Symfony and Doctrine refunds with the bugs money-lint finds, and the same code fixed.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "doctrine/orm": "^3.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/mailer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "ianfoxdev/money-lint": "@dev",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-doctrine": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
