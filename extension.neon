parametersSchema:
  money: structure([
    properties: listOf(string())
    attributes: listOf(string())
    transactions: listOf(string())
    sideEffects: listOf(string())
    queueAfterCommit: bool()
    balances: listOf(string())
    balanceWriters: listOf(string())
  ])

parameters:
  money:
    # fnmatch() patterns for property and parameter names that hold money, such as
    # '*amount' or 'balance'. Empty by default: see docs/adr/0001-what-counts-as-money.md.
    properties: []
    attributes:
      - IanFoxDev\MoneyLint\Attribute\Money

    # Methods that run a callback in a database transaction. 'Class::method', the class
    # matches its subtypes, several methods are joined with '|'.
    transactions:
      - Illuminate\Database\ConnectionInterface::transaction
      - Illuminate\Support\Facades\DB::transaction
      - DB::transaction
      - Doctrine\DBAL\Connection::transactional
      - Doctrine\ORM\EntityManagerInterface::wrapInTransaction

    # Calls that leave the process and cannot be rolled back: HTTP, email, brokers.
    sideEffects:
      - Psr\Http\Client\ClientInterface::sendRequest
      - GuzzleHttp\ClientInterface::send|sendAsync|request|requestAsync
      - GuzzleHttp\Client::get|head|put|post|patch|delete|getAsync|headAsync|putAsync|postAsync|patchAsync|deleteAsync
      - Symfony\Contracts\HttpClient\HttpClientInterface::request
      - Illuminate\Support\Facades\Http::get|head|post|put|patch|delete|send|pool
      - Http::get|head|post|put|patch|delete|send|pool
      - Illuminate\Http\Client\PendingRequest::get|head|post|put|patch|delete|send|pool
      - Illuminate\Support\Facades\Mail::send|raw|html|plain
      - Mail::send|raw|html|plain
      - Illuminate\Mail\PendingMail::send
      - Illuminate\Contracts\Mail\Mailer::send|raw|html|plain
      - Symfony\Component\Mailer\MailerInterface::send
      - PhpAmqpLib\Channel\AMQPChannel::basic_publish|publish_batch
      - RdKafka\ProducerTopic::produce|producev
      - Stripe\Service\AbstractService::*

    # Set to true when every queue connection has 'after_commit' => true in
    # config/queue.php: queued jobs then wait for the commit and money.dispatchInTransaction
    # has nothing to report.
    queueAfterCommit: false

    # Balances that only the ledger may change: 'App\Models\Wallet::balance' for a
    # model or entity, 'wallets.balance' for a table. Empty by default.
    balances: []
    # Classes that may change them: the ledger, and whatever it delegates to.
    balanceWriters: []

services:
  -
    class: IanFoxDev\MoneyLint\MoneyDetector
    arguments:
      properties: %money.properties%
      attributes: %money.attributes%
  -
    class: IanFoxDev\MoneyLint\MoneyExpressions
  -
    class: IanFoxDev\MoneyLint\Rules\Ledger\Balances
    arguments: [%money.balances%, %money.balanceWriters%]
  -
    class: IanFoxDev\MoneyLint\Rules\Race\FunctionNumberVisitor
    tags:
      - phpstan.parser.richParserNodeVisitor
  -
    class: IanFoxDev\MoneyLint\Rules\Race\Loads
  -
    class: IanFoxDev\MoneyLint\Rules\Race\CheckThenActCollector
    tags:
      - phpstan.collector
  moneyLint.transactions:
    class: IanFoxDev\MoneyLint\CallPatterns
    arguments: [%money.transactions%]
    autowired: false
  moneyLint.sideEffects:
    class: IanFoxDev\MoneyLint\CallPatterns
    arguments: [%money.sideEffects%]
    autowired: false
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\CallDescriber
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\TransactionCallbackVisitor
    arguments: [@moneyLint.transactions]
    tags:
      - phpstan.parser.richParserNodeVisitor
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\TransactionCallCollector
    arguments:
      transactions: @moneyLint.transactions
    tags:
      - phpstan.collector
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\QueuedDispatch
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\DispatchCollector
    tags:
      - phpstan.collector
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\DispatchInTransactionRule
    arguments:
      queueAfterCommit: %money.queueAfterCommit%
    tags:
      - phpstan.rules.rule
  -
    class: IanFoxDev\MoneyLint\Rules\Transaction\SideEffectCollector
    arguments:
      sideEffects: @moneyLint.sideEffects
    tags:
      - phpstan.collector

rules:
  - IanFoxDev\MoneyLint\Rules\Race\CheckThenActRule
  - IanFoxDev\MoneyLint\Rules\Ledger\BalanceOutsideLedgerRule
  - IanFoxDev\MoneyLint\Rules\Transaction\SideEffectInTransactionRule
  - IanFoxDev\MoneyLint\Rules\Float\FloatPropertyRule
  - IanFoxDev\MoneyLint\Rules\Float\FloatParameterRule
  - IanFoxDev\MoneyLint\Rules\Float\FloatConversionRule
