{
    "name": "ianfoxdev/money-lint",
    "description": "PHPStan rules for code that moves money: floats in amounts, HTTP calls inside database transactions, balance updates that skip the ledger, check-then-act without a lock.",
    "type": "phpstan-extension",
    "license": "MIT",
    "keywords": [
        "phpstan",
        "phpstan-extension",
        "static-analysis",
        "money",
        "payments",
        "fintech",
        "transactions",
        "laravel",
        "doctrine"
    ],
    "homepage": "https://github.com/IanFoxDev/money-lint",
    "authors": [
        {
            "name": "Anatoly Pankratyev",
            "email": "ianfoxdeveloper@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/IanFoxDev/money-lint/issues",
        "source": "https://github.com/IanFoxDev/money-lint"
    },
    "require": {
        "php": "^8.3",
        "phpstan/phpstan": "^2.1.3"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/mail": "^12.0 || ^13.0",
        "php-amqplib/php-amqplib": "^3.7",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "psr/http-client": "^1.0",
        "stripe/stripe-php": "^22.0",
        "symfony/http-client-contracts": "^3.5",
        "symfony/mailer": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "IanFoxDev\\MoneyLint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanFoxDev\\MoneyLint\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Rules/",
            "tests/stubs/"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
